{
  "name": "mang",
  "version": "1.0.0",
  "private": true,
  "description": "MANG - Restoran, Kafe ve KOBI'ler icin production-ready isletme yonetim platformu (POS, Mutfak, Muhasebe, CRM, Etkinlik)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=react-server tsx scripts/dev.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--conditions=react-server tsx scripts/migrate.ts",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed.ts",
    "db:reset": "NODE_OPTIONS=--conditions=react-server tsx scripts/reset.ts",
    "db:studio": "drizzle-kit studio",
    "setup": "npm run db:generate && NODE_OPTIONS=--conditions=react-server tsx scripts/setup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server tsx tests/e2e/flow.ts",
    "dev:next": "next dev -p 3000",
    "db:start": "NODE_OPTIONS=--conditions=react-server tsx scripts/db-start.ts",
    "db:stop": "NODE_OPTIONS=--conditions=react-server tsx scripts/db-stop.ts",
    "test:broker": "NODE_OPTIONS=--conditions=react-server tsx tests/e2e/broker.ts",
    "share": "bash scripts/share.sh",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "platform:admin": "NODE_OPTIONS=--conditions=react-server tsx scripts/grant-platform-admin.ts",
    "import:sales": "NODE_OPTIONS=--conditions=react-server tsx scripts/import-sales.ts",
    "audit": "NODE_OPTIONS=--conditions=react-server tsx tests/e2e/audit.ts",
    "audit:financial": "npm run audit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "jose": "6.2.10",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.7",
    "jsqr": "^1.4.0",
    "lucide-react": "1.39.0",
    "next": "15.5.25",
    "next-themes": "0.4.6",
    "nodemailer": "^10.0.1",
    "pg": "8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "web-push": "3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.25",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "3.2.4"
  }
}
